                {
                  "id": "ratio-row-vocab-stepper",
                  "type": "frame",
                  "layout": "horizontal",
                  "gap": 8,
                  "alignItems": "center",
                  "children": [
                    {
                      "id": "ratio-row-vocab-minus",
                      "type": "frame",
                      "width": 28,
                      "height": 28,
                      "cornerRadius": 8,
                      "fill": "$color.background",
                      "stroke": "$color.border",
                      "strokeWidth": 1,
                      "alignItems": "center",
                      "justifyContent": "center",
                      "children": [ { "id": "ratio-row-vocab-minus-text", "type": "text", "content": "-", "fontSize": 16, "fill": "$color.textPrimary" } ]
                    },
                    { "id": "ratio-row-vocab-value", "type": "text", "content": "25", "fontSize": 14, "fontWeight": "bold", "fill": "$color.textPrimary", "width": 28, "textAlign": "center" },
                    {
                      "id": "ratio-row-vocab-plus",
                      "type": "frame",
                      "width": 28,
                      "height": 28,
                      "cornerRadius": 8,
                      "fill": "$color.background",
                      "stroke": "$color.border",
                      "strokeWidth": 1,
                      "alignItems": "center",
                      "justifyContent": "center",
                      "children": [ { "id": "ratio-row-vocab-plus-text", "type": "text", "content": "+", "fontSize": 16, "fill": "$color.textPrimary" } ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "ratio-row-sentence",
              "type": "frame",
              "layout": "horizontal",
              "justifyContent": "space_between",
              "alignItems": "center",
              "width": "fill_container",
              "padding": [10, 0],
              "children": [
                { "id": "ratio-row-sentence-label", "type": "text", "content": "문장", "fontSize": 14, "fill": "$color.textPrimary" },
                {
                  "id": "ratio-row-sentence-stepper",
                  "type": "frame",
                  "layout": "horizontal",
                  "gap": 8,
                  "alignItems": "center",
                  "children": [
                    {
                      "id": "ratio-row-sentence-minus",
                      "type": "frame",
                      "width": 28,
                      "height": 28,
                      "cornerRadius": 8,
                      "fill": "$color.background",
                      "stroke": "$color.border",
                      "strokeWidth": 1,
                      "alignItems": "center",
                      "justifyContent": "center",
                      "children": [ { "id": "ratio-row-sentence-minus-text", "type": "text", "content": "-", "fontSize": 16, "fill": "$color.textPrimary" } ]
                    },
                    { "id": "ratio-row-sentence-value", "type": "text", "content": "15", "fontSize": 14, "fontWeight": "bold", "fill": "$color.textPrimary", "width": 28, "textAlign": "center" },
                    {
                      "id": "ratio-row-sentence-plus",
                      "type": "frame",
                      "width": 28,
                      "height": 28,
                      "cornerRadius": 8,
                      "fill": "$color.background",
                      "stroke": "$color.border",
                      "strokeWidth": 1,
                      "alignItems": "center",
                      "justifyContent": "center",
                      "children": [ { "id": "ratio-row-sentence-plus-text", "type": "text", "content": "+", "fontSize": 16, "fill": "$color.textPrimary" } ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "ratio-divider",
              "type": "rectangle",
              "width": "fill_container",
              "height": 1,
              "fill": "$color.border"
            },
            {
              "id": "ratio-reset-btn",
              "type": "frame",
              "layout": "horizontal",
              "justifyContent": "center",
              "alignItems": "center",
              "padding": [10, 16],
              "cornerRadius": 10,
              "fill": "$color.background",
              "stroke": "$color.primary",
              "strokeWidth": 1.5,
              "width": "fill_container",
              "children": [
                { "id": "ratio-reset-btn-text", "type": "text", "content": "기본값으로 초기화", "fontSize": 13, "fontWeight": "bold", "fill": "$color.primary", "textAlign": "center" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
