                    { "id": "ratio-row-kanji-value", "type": "text", "content": "20", "fontSize": 14, "fontWeight": "bold", "fill": "$color.textPrimary", "width": 28, "textAlign": "center" },
                    {
                      "id": "ratio-row-kanji-plus",
                      "type": "frame",
                      "width": 28,
                      "height": 28,
                      "cornerRadius": 8,
